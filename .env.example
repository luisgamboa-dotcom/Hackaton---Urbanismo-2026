# Application
APP_NAME="Trama Urbana Verde"
APP_ENV=development
DEBUG=true

# Database (Supabase / PostgreSQL)
# Formato: postgresql+asyncpg://user:password@host:port/dbname
# Para Supabase con pooler: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Stitch Design System (opcional - para sincronización automática de tokens)
STITCH_PROJECT_ID=17540452302289583695

# Security (para futuras features de auth)
SECRET_KEY=your-secret-key-here-generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"