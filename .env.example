# Application
APP_NAME="Green Tech"
APP_ENV=development
DEBUG=true

# Database - Using SQLite for local development (no external DB needed)
# For production with PostgreSQL (Render), use:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./trama_urbana_verde.db

# Stitch Design System (optional - for automatic token sync)
STITCH_PROJECT_ID=17540452302289583695

# Security
SECRET_KEY=generate-with-python-secrets-module

# Email (SMTP) - Gmail configuration
# Create App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM="Green Tech <noreply@yourdomain.cl>"
EMAIL_TO=recipient@example.com